{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "初始化环境（创建 .venv 并安装依赖）",
      "type": "shell",
      "windows": {
        "command": "python -m venv .venv; .venv\\Scripts\\python -m pip install -e \".[dev,proxy]\""
      },
      "osx": { "command": "python3 -m venv .venv && .venv/bin/python -m pip install -e '.[dev,proxy]'" },
      "linux": { "command": "python3 -m venv .venv && .venv/bin/python -m pip install -e '.[dev,proxy]'" },
      "problemMatcher": []
    },
    {
      "label": "运行全部测试",
      "type": "shell",
      "windows": { "command": ".venv\\Scripts\\python -m pytest" },
      "osx": { "command": ".venv/bin/python -m pytest" },
      "linux": { "command": ".venv/bin/python -m pytest" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
